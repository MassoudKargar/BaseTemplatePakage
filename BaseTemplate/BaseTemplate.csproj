<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
	  <Version>10.0.0</Version>
    <PackageId>Base.Solution.Templates</PackageId>
    <Title>Base Solution Templates</Title>
    <Authors>Masoud kargar</Authors>
    <Description>Templates to use when creting an application using base framework.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RepositoryUrl>https://github.com/MassoudKargar</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>base.png</PackageIcon>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="base.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\.vs\**;templates\**\.idea\**;templates\**\*.user;templates\**\*.suo" />
    <!-- Older tracked files use Templates; merge them into the same package path on case-sensitive hosts. -->
    <Content Include="Templates\**\*"
             Condition="'$(OS)' != 'Windows_NT'"
             Exclude="Templates\**\bin\**;Templates\**\obj\**;Templates\**\.vs\**;Templates\**\.idea\**;Templates\**\*.user;Templates\**\*.suo"
             PackagePath="content/templates/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*" />
  </ItemGroup>
</Project>
