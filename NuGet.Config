<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repository development only; this file is outside the packaged template. -->
  <config>
    <add key="globalPackagesFolder" value="artifacts/current-base-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="current-base" value="%BASE_PACKAGE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="current-base"><package pattern="Base.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>